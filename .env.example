# ─── Firebase (Project settings → General → Your apps → Web app) ───
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Project settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=

# ─── Google Apps Script (мост к Google-таблице) ───
# Deploy → New deployment → Web app → URL вида https://script.google.com/macros/s/.../exec
VITE_APPS_SCRIPT_URL=

# ─── Почты трёх кабинетов (те же, что вы создадите в Firebase → Authentication) ───
VITE_EMAIL_SERAFIM=
VITE_EMAIL_KUZMA=
VITE_EMAIL_ANTON=

# Базовый путь сайта. Для GitHub Pages: /имя-репозитория/   Для Firebase Hosting: /
VITE_BASE=/
